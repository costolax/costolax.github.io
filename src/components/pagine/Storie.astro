---
import Base from '../../layouts/Base.astro';
import Testata from '../Testata.astro';
import StoriaCard from '../StoriaCard.astro';
import decorazione from '../../assets/laterali/costolax-n0-senza-scritte.webp';
import { inclina, ordinati } from '../../lib/contenuti';
import { t, type Lingua } from '../../i18n/ui';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const testo = t(lingua).storie;
const storie = await ordinati('storie');
---

<Base lingua={lingua} sezione="storie" titolo={testo.titolo} descrizione={testo.descrizione}>
  <Testata decorazione={decorazione} lingua={lingua} inquadratura="50% 25%">
    <h1>{testo.titolo}</h1>
    <p>{testo.intro}</p>
  </Testata>

  <section class="wrap sezione">
    <div class="elenco">
      {storie.map((storia, i) => <StoriaCard storia={storia} lingua={lingua} inclina={inclina(i)} loading={i < 2 ? 'eager' : undefined} />)}
    </div>
  </section>
</Base>

<style>
  .elenco {
    display: grid;
    gap: calc(var(--gutter) + 18px);
    max-width: 960px;
  }
</style>
