---
// Intestazione di pagina con una tavola di decorazione accanto al titolo.
// La tavola è un ornamento, ma si può cliccare per vederla a schermo intero.
import type { ImageMetadata } from 'astro';
import Ingrandibile from './Ingrandibile.astro';
import type { Lingua } from '../i18n/ui';

interface Props {
  decorazione: ImageMetadata;
  lingua: Lingua;
  // Parte della tavola da tenere in vista quando viene ritagliata (CSS object-position).
  inquadratura?: string;
}

const { decorazione, lingua, inquadratura = '50% 30%' } = Astro.props;
---

<section class="wrap testata con-decorazione">
  <div class="testata-testo">
    <slot />
  </div>
  <div class="riquadro decorazione inclina-d" style={`aspect-ratio: ${decorazione.width} / ${decorazione.height}`}>
    <Ingrandibile src={decorazione} alt="" lingua={lingua} widths={[320, 560, 800]} sizes="(max-width: 700px) 110px, 260px" loading="eager" style={`object-position: ${inquadratura}`} />
  </div>
</section>

<style>
  .con-decorazione {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }

  /* la tavola ha le sue proporzioni (vedi style nel markup): si vede sempre intera */
  .decorazione {
    overflow: hidden;
  }

  .decorazione :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* su telefono la tavola resta intera, piccola, accanto al titolo */
  @media (max-width: 700px) {
    .con-decorazione {
      grid-template-columns: minmax(0, 1fr) 110px;
      gap: 18px;
      align-items: start;
    }

    /* il titolo segue la larghezza dello schermo, così parole lunghe come "collettivo" stanno nella colonna */
    .testata-testo :global(h1) {
      font-size: min(7.4vw, 2.6rem);
    }
  }
</style>
