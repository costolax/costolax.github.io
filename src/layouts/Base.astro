---
import '@fontsource/bowlby-one';
import '@fontsource/permanent-marker';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Visualizzatore from '../components/Visualizzatore.astro';
import copertinaPredefinita from '../assets/fumetti/costolax-n0.webp';
import { sito } from '../site.config';
import { url } from '../lib/utils';
import { link, lingue, t, type Lingua, type Sezione } from '../i18n/ui';

interface Props {
  lingua: Lingua;
  // Sezione e scheda della pagina: servono a collegare la stessa pagina nell'altra lingua.
  // Senza sezione (es. pagina 404) il cambio lingua porta alla home.
  sezione?: Sezione;
  id?: string;
  titolo?: string;
  descrizione?: string;
  immagine?: ImageMetadata;
  nascondiDaiMotori?: boolean;
}

const { lingua, sezione = 'home', id, titolo, immagine, nascondiDaiMotori = false } = Astro.props;
const testo = t(lingua);
const descrizione = Astro.props.descrizione ?? testo.descrizione;

// In home il titolo è solo il nome: nei risultati di ricerca compare "Costolax" seguito dalla descrizione.
const titoloCompleto = titolo ? `${titolo} · ${sito.nome}` : sito.nome;
const canonico = new URL(Astro.url.pathname, Astro.site);
const versioni = (Object.keys(lingue) as Lingua[]).map((l) => ({
  lingua: l,
  href: link(l, sezione, id),
}));
const anteprima = await getImage({ src: immagine ?? copertinaPredefinita, width: 1080, format: 'jpg' });
const anteprimaUrl = new URL(anteprima.src, Astro.site);

// Dati strutturati solo in home: dicono a Google il nome del sito ("Costolax") e il logo del collettivo.
const home = new URL(link(lingua, 'home'), Astro.site);
const datiStrutturati =
  sezione === 'home' && !nascondiDaiMotori
    ? JSON.stringify([
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: sito.nome,
          url: home,
          inLanguage: lingua,
          description: descrizione,
        },
        {
          '@context': 'https://schema.org',
          '@type': 'Organization',
          name: sito.nome,
          url: new URL('/', Astro.site),
          logo: new URL(url('favicon-192.png'), Astro.site),
          sameAs: [sito.instagram],
        },
      ])
    : null;
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico} />
    {
      !nascondiDaiMotori &&
        versioni.map((v) => <link rel="alternate" hreflang={v.lingua} href={new URL(v.href, Astro.site)} />)
    }
    {!nascondiDaiMotori && <link rel="alternate" hreflang="x-default" href={new URL(link('it', sezione, id), Astro.site)} />}
    <!-- Google mostra l'icona nei risultati solo se è quadrata e multipla di 48px (48, 96, 192...). -->
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={url('favicon-96.png')} sizes="96x96" />
    <link rel="icon" type="image/png" href={url('favicon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="theme-color" content="#151212" />
    <!-- Applica subito il tema scelto col pulsante (chiaro/scuro), prima di disegnare la pagina. -->
    <script is:inline>
      try {
        const tema = localStorage.getItem('tema');
        if (tema === 'chiaro' || tema === 'scuro') document.documentElement.dataset.tema = tema;
      } catch {}
    </script>
    {nascondiDaiMotori && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lingua === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:site_name" content={sito.nome} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={anteprimaUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {datiStrutturati && <script type="application/ld+json" set:html={datiStrutturati} />}
  </head>
  <body>
    <a class="salta sr-only" href="#contenuto">{testo.saltaAlContenuto}</a>
    <Header lingua={lingua} versioni={versioni} />
    <main id="contenuto">
      <slot />
    </main>
    <Footer lingua={lingua} />
    <Visualizzatore lingua={lingua} />
  </body>
</html>

<style>
  .salta:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0.6em 1em;
    clip: auto;
    background: var(--giallo);
    color: var(--nero);
    border: 3px solid var(--inchiostro);
    font-weight: 700;
  }
</style>
